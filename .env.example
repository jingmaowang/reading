ELEVENLABS_API_KEY=your_api_key
ELEVENLABS_VOICE_ID=your_cloned_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 语速：0.25~4.0；1.0 正常，0.9 稍慢，1.1 稍快
ELEVENLABS_SPEED=0.9
# 稳定性：0~1；越高越稳定，越低情绪变化越多
ELEVENLABS_STABILITY=0.5
# 声音相似度：0~1；越高越接近原声音，也可能放大录音瑕疵
ELEVENLABS_SIMILARITY_BOOST=0.75
# 风格强度：0~1；0 不额外夸张原声音风格
ELEVENLABS_STYLE=0.0
# 声音增强：true / false
ELEVENLABS_USE_SPEAKER_BOOST=true

# 数字、日期等文本规范化：auto / on / off
ELEVENLABS_TEXT_NORMALIZATION=auto
# MP3 格式；192kbps 需要 Creator 或更高套餐
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# 随机种子：留空为随机；可填 0~4294967295，仅尽力复现，不保证完全一致
ELEVENLABS_SEED=
